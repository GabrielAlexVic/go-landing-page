{
	"info": {
		"_postman_id": "b3f2e1a4-9876-4abc-8def-[#00F5A0]",
		"name": "GVByte Landing Page & Analytics API",
		"description": "Collection de endpoints para o serviço de métricas e analytics da landing page da GVByte.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Autenticação",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    console.log('Token JWT salvo com sucesso!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@gvbyte.com\",\n  \"password\": \"sua_senha_aqui\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica o admin e salva o token JWT automaticamente na variável da coleção."
					},
					"response": []
				},
				{
					"name": "Gerar Hash de Senha",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"password\": \"sua_senha_aqui\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/hash-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"hash-password"
							]
						},
						"description": "Utilitário para gerar hash bcrypt de uma senha plana."
					},
					"response": []
				}
			]
		},
		{
